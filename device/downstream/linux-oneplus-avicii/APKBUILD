# Reference: <https://postmarketos.org/vendorkernel>
# Kernel config based on: arch/arm64/configs/vendor/lito-perf_defconfig
maintainer="Yurii <selestyn@gmail.com>"
pkgname=linux-oneplus-avicii
pkgver=4.19.300
pkgrel=0
pkgdesc="OnePlus Nord kernel fork"
arch="aarch64"
_carch="arm64"
_flavor="oneplus-avicii"
url="https://kernel.org"
license="GPL-2.0-only"
options="!strip !check !tracedeps pmb:cross-native"
makedepends="
	bash
	bc
	bison
	clang
	devicepkg-dev
	findutils
	flex
	linux-headers
	openssl-dev
	perl
	xz
"

# кросс-тулчейн ставится в нативный chroot: пакеты существуют только для хоста,
# а makedepends резолвятся под целевую архитектуру
makedepends_build="
	gcc-aarch64
	g++-aarch64
"

export CC="clang"
export HOSTCC="clang"

_repository="android_kernel_oneplus_sm7250"
_commit="fb4b4374d3b9ad0f10ba38d159585129f092fb3d"
_config="config-$_flavor.$arch"
source="
	$pkgname-$_commit.tar.gz::https://github.com/LineageOS/$_repository/archive/$_commit.tar.gz
	$_config
	0001-idle-kthreads-no-loadavg.patch
	0002-oplus-midas-pidns-null-deref.patch
	0003-exit-backport-P_PIDFD-support-for-waitid.patch
"

builddir="$srcdir/$_repository-$_commit"
_outdir="out"

prepare() {
	default_prepare
	REPLACE_GCCH=0 . downstreamkernel_prepare
}

build() {
	unset LDFLAGS
	make O="$_outdir" ARCH="$_carch" CC="${CC:-gcc}" \
		BRAND_SHOW_FLAG=oneplus \
		KBUILD_BUILD_VERSION="$((pkgrel + 1 ))-postmarketOS"
}

package() {
	downstreamkernel_package "$builddir" "$pkgdir" "$_carch" \
		"$_flavor" "$_outdir"

	# Базовый DTB для mkbootimg (boot header v2). Оверлей устройства
	# (avicii-overlay.dtbo) не ставим: загрузчик берёт его из штатного
	# раздела dtbo и накладывает на этот dtb сам.
	install -Dm644 "$_outdir/arch/arm64/boot/dts/vendor/20801/lito.dtb" \
		"$pkgdir/boot/dtbs/vendor/20801/lito.dtb"

	make O="$_outdir" ARCH="$_carch" \
		INSTALL_MOD_STRIP=1 \
		INSTALL_MOD_PATH="$pkgdir" \
		modules_install
}

