# Reference: <https://postmarketos.org/devicepkg>
maintainer="Yurii <selestyn@gmail.com>"
pkgname=device-oneplus-avicii
pkgver=1
pkgrel=0
pkgdesc="OnePlus Nord"
url="https://postmarketos.org"
arch="aarch64"
license="MIT"
depends="
	avicii-wlan
	font-terminus
	linux-oneplus-avicii
	mkbootimg
	msm-firmware-loader
	soc-qcom-qbootctl
	swclock-offset
	postmarketos-base
	postmarketos-base-downstream
	"
makedepends="devicepkg-dev"
install="$pkgname.post-install $pkgname.post-upgrade"
source="
	deviceinfo
	kernel-cmdline.conf
	modules-initfs
	avicii-qbootctl.initd
	avicii-firmware.initd
	avicii-firmware.sh
	"
options="!archcheck !check"

build() {
	devicepkg_build $startdir $pkgname
}

package() {
	devicepkg_package $startdir $pkgname

	install -Dm755 "$srcdir"/avicii-qbootctl.initd "$pkgdir"/etc/init.d/avicii-qbootctl
	install -Dm755 "$srcdir"/avicii-firmware.initd "$pkgdir"/etc/init.d/avicii-firmware
	install -Dm755 "$srcdir"/avicii-firmware.sh "$pkgdir"/usr/libexec/avicii-firmware
}

