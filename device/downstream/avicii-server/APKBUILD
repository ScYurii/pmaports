# Running the OnePlus Nord (avicii) as an always-on home server:
# - avicii-chglimit: keeps the battery between 70 and 80% on mains power
#   (OPLUS mmi_charging_enable + input_suspend)
# - avicii-power: live power draw in the terminal
# - avicii-monitor: metrics collector and web dashboard on port 8080
# - Docker workarounds for the downstream 4.19 kernel (crun instead of runc,
#   iptables-legacy, cgroup v1, no schedtune), docker enabled at boot
# - bash and the docker group for the default user
maintainer="Yurii <selestyn@gmail.com>"
pkgname=avicii-server
pkgver=1
pkgrel=1
pkgdesc="Home server setup for OnePlus Nord (downstream kernel)"
url="https://postmarketos.org"
arch="aarch64"
license="GPL-3.0-or-later"
depends="
	bash
	bash-completion
	busybox-extras
	crun
	docker
	docker-bash-completion
	docker-openrc
	iptables-legacy
	iw
	python3
	shadow
	"
install="$pkgname.post-install $pkgname.post-upgrade $pkgname.pre-deinstall"
source="
	avicii-chglimit.sh
	avicii-chglimit.initd
	avicii-chglimit.confd
	avicii-power.sh
	avicii-monitor.py
	avicii-monitor.initd
	avicii-monitor-web.initd
	avicii-monitor.html
	avicii-monitor-httpd.conf
	avicii-docker-daemon.json
	avicii-docker-modules.conf
	avicii-user-setup.sh
	avicii-user-setup.initd
	"
builddir="$srcdir"
options="!check"

package() {
	install -Dm755 avicii-chglimit.sh "$pkgdir"/usr/sbin/avicii-chglimit
	install -Dm755 avicii-chglimit.initd "$pkgdir"/etc/init.d/avicii-chglimit
	install -Dm644 avicii-chglimit.confd "$pkgdir"/etc/conf.d/avicii-chglimit
	install -Dm755 avicii-power.sh "$pkgdir"/usr/bin/avicii-power

	install -Dm755 avicii-monitor.py "$pkgdir"/usr/sbin/avicii-monitor
	install -Dm755 avicii-monitor.initd "$pkgdir"/etc/init.d/avicii-monitor
	install -Dm755 avicii-monitor-web.initd "$pkgdir"/etc/init.d/avicii-monitor-web
	install -Dm644 avicii-monitor.html "$pkgdir"/usr/share/avicii-monitor/www/index.html
	install -Dm644 avicii-monitor-httpd.conf "$pkgdir"/usr/share/avicii-monitor/httpd.conf
	ln -s /run/avicii-monitor "$pkgdir"/usr/share/avicii-monitor/www/data

	install -Dm644 avicii-docker-daemon.json "$pkgdir"/etc/docker/daemon.json
	install -Dm644 avicii-docker-modules.conf "$pkgdir"/etc/modules-load.d/avicii-docker.conf
	mkdir -p "$pkgdir"/usr/lib/$pkgname/docker-bin
	ln -s /usr/bin/iptables-legacy "$pkgdir"/usr/lib/$pkgname/docker-bin/iptables
	ln -s /usr/bin/ip6tables-legacy "$pkgdir"/usr/lib/$pkgname/docker-bin/ip6tables

	install -Dm755 avicii-user-setup.sh "$pkgdir"/usr/libexec/avicii-user-setup
	install -Dm755 avicii-user-setup.initd "$pkgdir"/etc/init.d/avicii-user-setup
}
