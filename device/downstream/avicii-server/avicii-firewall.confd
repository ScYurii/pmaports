# Домашняя сеть: из неё открыты порты TCP_PORTS, всё остальное закрыто
LAN="192.168.1.0/24"
# Порты TCP для домашней сети: SSH, дашборд питания, аналитический дашборд
TCP_PORTS="22 8080 8081"
# USB-кабель к ноуту: разрешено всё, это запасной вход
USB_IF="usb0"
# Wi-Fi: через него приходят соединения к портам, опубликованным Docker
WAN_IF="wlan0"
