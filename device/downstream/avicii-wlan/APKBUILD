# Wi-Fi for OnePlus Nord (avicii) on the downstream 4.19 kernel without
# Android: the WLAN firmware runs inside the modem (wlan_pd), so this brings
# up the modem helpers and replaces vendor cnss-daemon with wlfwd.
# Upstream tools are patched for kernels without /sys/class/remoteproc and
# installed privately in /usr/lib/avicii-wlan to not clash with Alpine's.
maintainer="Yurii <selestyn@gmail.com>"
pkgname=avicii-wlan
pkgver=1
pkgrel=0
_qrtr_ver=1.0
_tqftpserv_ver=1.2
_pdmapper_commit=5ecd2fe926aca7abfe40724177f63b942cff3947
_wlfwd_ver=0.1.0
pkgdesc="Wi-Fi bring-up for OnePlus Nord (downstream kernel)"
url="https://github.com/ScYurii/wlfwd"
arch="aarch64"
license="BSD-3-Clause AND GPL-2.0-only"
depends="rmtfs qrtr-libs"
makedepends="linux-headers meson qrtr-dev xz-dev zstd-dev"
install="$pkgname.post-install $pkgname.pre-deinstall"
source="
	qrtr-$_qrtr_ver.tar.gz::https://github.com/linux-msm/qrtr/archive/refs/tags/v$_qrtr_ver.tar.gz
	tqftpserv-$_tqftpserv_ver.tar.gz::https://github.com/linux-msm/tqftpserv/archive/refs/tags/v$_tqftpserv_ver.tar.gz
	pd-mapper-$_pdmapper_commit.tar.gz::https://github.com/linux-msm/pd-mapper/archive/$_pdmapper_commit.tar.gz
	wlfwd-$_wlfwd_ver.tar.gz::https://github.com/ScYurii/wlfwd/archive/refs/tags/v$_wlfwd_ver.tar.gz
	tqftpserv-fw-dir.patch
	pd-mapper-jsn-dir.patch
	avicii-wlan.sh
	qrtr-ns.initd
	rmtfs-ro.initd
	tqftpserv-fw.initd
	pd-mapper.initd
	avicii-wlan.initd
	"
builddir="$srcdir"
options="!check"

# Stable directory names, so the patches apply from $srcdir via default_prepare
prepare() {
	mv qrtr-$_qrtr_ver qrtr
	mv tqftpserv-$_tqftpserv_ver tqftpserv
	mv pd-mapper-$_pdmapper_commit pd-mapper
	mv wlfwd-$_wlfwd_ver wlfwd
	default_prepare
}

build() {
	make -C qrtr qrtr-ns

	meson setup tqftpserv/output tqftpserv \
		-Dsystemd-unit-prefix=/unused
	meson compile -C tqftpserv/output

	make -C pd-mapper

	make -C wlfwd CC="${CC:-gcc}"
}

package() {
	local lib="$pkgdir"/usr/lib/$pkgname

	install -Dm755 qrtr/qrtr-ns "$lib"/qrtr-ns
	install -Dm755 tqftpserv/output/tqftpserv "$lib"/tqftpserv
	install -Dm755 pd-mapper/pd-mapper "$lib"/pd-mapper
	install -Dm755 wlfwd/wlfwd "$lib"/wlfwd
	install -Dm755 wlfwd/pdr-restart "$lib"/pdr-restart
	install -Dm755 avicii-wlan.sh "$lib"/avicii-wlan

	local s
	for s in qrtr-ns rmtfs-ro tqftpserv-fw pd-mapper avicii-wlan; do
		install -Dm755 $s.initd "$pkgdir"/etc/init.d/$s
	done
}
